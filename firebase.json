{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/*.exe",
      "**/*.msi",
      "**/*.zip",
      "**/*.rar",
      "**/*.mp4",
      "**/*.mp3",
      "**/*.pdf",
      "**/*.iso",
      "**/*.dmg",
      "**/*.pkg",
      "**/*.dll",
      "**/*.sys",
      "**/*.bat",
      "**/*.ps1",
      "**/*.sh",
      "**/*.7z",
      "**/*.tar",
      "**/*.gz",
      "**/*.lnk",
      "**/*.ini",
      "**/*.cfg",
      "**/*.db",
      "**/*.sqlite"
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  }
}